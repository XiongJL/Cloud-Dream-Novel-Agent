{
  "name": "novel-editor-desktop",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "XiongJL",
  "description": "云梦小说智能体桌面端",
  "scripts": {
    "dev": "vite",
    "dev:8080": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "dev:local": "vite --host 127.0.0.1 --strictPort",
    "prepare:core": "pnpm --dir ../.. --filter @novel-editor/core run build",
    "predev": "pnpm run prepare:core",
    "copy-prisma": "node scripts/copy-prisma.js",
    "mcp:bridge": "node scripts/novel-editor-mcp.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:config": "node scripts/mcp-print-config.mjs",
    "ai:diag": "node scripts/ai-dev-diagnostics.mjs",
    "test:agent-sse": "node scripts/agent-sse-protocol-test.mjs",
    "test:agent-sse-client": "node scripts/agent-sse-client-test.mjs",
    "test:agent-run-recovery": "node scripts/agent-run-recovery-test.mjs",
    "test:agent-retry-renderer": "node scripts/agent-retry-renderer-contract-test.mjs",
    "test:agent-runtime-health": "node scripts/agent-runtime-health-policy-test.mjs",
    "test:agent-runtime-client": "node scripts/agent-runtime-client-recovery-test.mjs",
    "test:agent-runtime-renderer": "node scripts/agent-runtime-renderer-contract-test.mjs",
    "test:draft-session-recovery": "node scripts/draft-session-recovery-test.mjs",
    "test:review-comments": "node scripts/review-comment-store-test.mjs",
    "test:review-workflow-renderer": "node scripts/review-workflow-renderer-contract-test.mjs",
    "test:creative-assets-review": "node scripts/creative-assets-review-contract-test.mjs",
    "test:creative-assets-writeback": "node scripts/creative-assets-writeback-test.mjs",
    "test:draft-batch-commit": "node scripts/draft-batch-commit-test.mjs",
    "test:draft-batch-review": "node scripts/draft-batch-review-projection-test.mjs",
    "test:text-diff": "node scripts/text-diff-test.mjs",
    "test:agent-sqlite-recovery": "node scripts/agent-sqlite-recovery-test.mjs",
    "test:agent-conversation-timeline": "node scripts/agent-conversation-timeline-test.mjs",
    "test:agent-json-parser": "node scripts/agent-json-parser-test.mjs",
    "test:agent-plan-goal": "node scripts/agent-plan-goal-test.mjs",
    "test:agent-activity": "node scripts/agent-activity-projection-test.mjs",
    "test:agent-pending-status": "node scripts/agent-pending-status-test.mjs",
    "test:agent-context": "node scripts/agent-context-assembler-test.mjs",
    "test:agent-review": "node scripts/agent-review-store-test.mjs",
    "test:agent-revision-todo": "node scripts/agent-revision-todo-contract-test.mjs",
    "test:agent-scope-selection": "node scripts/agent-chapter-scope-selection-test.mjs",
    "test:agent-report-projection": "node scripts/agent-expert-report-projection-test.mjs",
    "test:agent-ui-colors": "node scripts/agent-light-color-contract-test.mjs",
    "test:lexical-document": "node scripts/lexical-document-test.mjs",
    "test:narrative-state": "node scripts/narrative-state-test.mjs",
    "test:http-responses-stream": "node scripts/http-responses-stream-test.mjs",
    "test:http-provider-retry": "node scripts/http-provider-retry-contract-test.mjs",
    "test:agent-recovery": "pnpm run test:agent-sse && pnpm run test:agent-sse-client && pnpm run test:agent-run-recovery && pnpm run test:agent-retry-renderer && pnpm run test:agent-runtime-health && pnpm run test:agent-runtime-client && pnpm run test:agent-runtime-renderer && pnpm run test:draft-session-recovery && pnpm run test:review-comments && pnpm run test:review-workflow-renderer && pnpm run test:creative-assets-review && pnpm run test:creative-assets-writeback && pnpm run test:draft-batch-commit && pnpm run test:draft-batch-review && pnpm run test:text-diff && pnpm run test:agent-sqlite-recovery && pnpm run test:agent-conversation-timeline && pnpm run test:agent-json-parser && pnpm run test:agent-plan-goal && pnpm run test:agent-activity && pnpm run test:agent-pending-status && pnpm run test:agent-context && pnpm run test:agent-review && pnpm run test:agent-revision-todo && pnpm run test:agent-scope-selection && pnpm run test:agent-report-projection && pnpm run test:lexical-document && pnpm run test:narrative-state && pnpm run test:http-responses-stream && pnpm run test:http-provider-retry",
    "build": "pnpm run prepare:core && tsc && vite build && electron-builder",
    "build:win:dir": "pnpm run prepare:core && tsc && vite build && electron-builder --win dir && pnpm run fix:win:exe-icon",
    "fix:win:exe-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-win-exe-icon.ps1 -AppOutDir release/win-unpacked -ProjectDir .",
    "pack:win:prepackaged": "electron-builder --win nsis portable --prepackaged release/win-unpacked",
    "build:win": "pnpm run build:win:dir && pnpm run pack:win:prepackaged",
    "build:mac": "pnpm run prepare:core && tsc && vite build && electron-builder --mac dmg --universal",
    "preview": "vite preview"
  },
  "dependencies": {
    "@novel-editor/core": "workspace:*",
    "adm-zip": "^0.5.16",
    "diff": "^9.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@lexical/history": "^0.40.0",
    "@lexical/mark": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@types/adm-zip": "^0.5.7",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "clsx": "^2.1.0",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "framer-motion": "^12.29.2",
    "i18next": "^25.8.0",
    "konva": "^8.4.3",
    "lexical": "^0.40.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "react-konva": "^18.2.14",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
